<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Agent Image -->
    <ImageView
        android:id="@+id/agentImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:contentDescription="Agent Image" />

    <!-- Agent Name -->
    <TextView
        android:id="@+id/agentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brimstone"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium" />

    <!-- Agent Special Ability -->

    <!-- Button to Trigger Ability -->
    <TextView
        android:id="@+id/specialAbility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:text="Ultimate: Open up the sky"
        android:textColor="#FFD700"
        android:textSize="16sp"
        android:visibility="visible" />

    <Button
        android:id="@+id/triggerAbilityButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:text="Trigger Ability"
        android:textColor="#FFFFFF" />

</LinearLayout>
